from waflib import Logs
import os

top = '.'

def options(opt):
	return

def configure(conf):
	# the engine's --mister-hybrid: a second thread for the renderer (r_jobs.c)
	conf.env.SOFT_MISTER_HYBRID = conf.options.MISTER_HYBRID

def build(bld):
	libs = [ 'ref_common', 'engine_includes', 'werror', 'yy_thunks' ]
	# on PSVita do not link any libraries that are already in the main executable, but add the includes target
	if bld.env.DEST_OS == 'psvita':
		libs += [ 'sdk_includes' ]
	else:
		libs += [ 'public', 'M' ]

	bld.shlib(source   = bld.path.ant_glob('*.c'),
		target   = 'ref_soft',
		includes = '.',
		defines  = 'REF_DLL=1 MISTER_HYBRID=1' if bld.env.SOFT_MISTER_HYBRID else 'REF_DLL=1',
		features = 'format',
		use      = libs,
		install_path = bld.env.LIBDIR
	)
